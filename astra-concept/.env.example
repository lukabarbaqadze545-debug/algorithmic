# Copy to .env.local. None of these are required for the demo.
# Nothing here may contain secrets: VITE_* variables are bundled into public JavaScript.

# "deterministic" (default): scripted FAQ engine, zero network calls.
# "remote": send questions to YOUR OWN server-side endpoint (see src/lib/concierge/remoteEngine.ts).
VITE_CONCIERGE_MODE=deterministic

# Only read when VITE_CONCIERGE_MODE=remote. The endpoint holds the AI provider key server-side.
VITE_CONCIERGE_ENDPOINT=

# Future: real booking / CRM intake endpoint (unused in the demo, bookings stay in localStorage).
VITE_BOOKING_ENDPOINT=
